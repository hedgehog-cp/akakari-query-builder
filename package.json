{
  "name": "akakari-query-builder",
  "version": "1.0.0",
  "private": true,
  "description": "赤仮形式のCSVファイルのクエリを構築するGUI.",
  "keywords": [
    "kancolle",
    "艦これ",
    "赤仮",
    "logbook",
    "csv",
    "query"
  ],
  "homepage": "https://hedgehog-cp.github.io/akakari-query-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedgehog-cp/akakari-query-builder.git"
  },
  "bugs": {
    "url": "https://github.com/hedgehog-cp/akakari-query-builder/issues"
  },
  "author": "hedgehog-cp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "gen:master": "node tools/gen-master.mjs",
    "update:schema-fallback": "node tools/update-schema-fallback.mjs",
    "check:schema-urls": "node tools/check-schema-urls.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.9.2",
    "@types/sortablejs": "^1.15.9",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "preact": "^10.29.8",
    "sortablejs": "^1.15.7"
  }
}
